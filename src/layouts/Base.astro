---
import "../styles/global.css";
import type { SiteContent } from "../data/types";

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = `${site}${t.lang === "es" ? "/" : "/en/"}`;
const ogImage = `${site}/og.png`;
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={t.person.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#9b1c31" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.lang === "es" ? "es_PE" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: t.person.name,
        jobTitle: t.person.role,
        email: `mailto:${t.person.email}`,
        url: canonical,
        sameAs: [t.person.linkedin, t.person.github],
        alumniOf: "Pontificia Universidad Católica del Perú",
      })}
    />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] btn">
      {t.lang === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    <slot />
  </body>
</html>
