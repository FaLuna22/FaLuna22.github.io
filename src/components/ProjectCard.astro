---
import Icon from "./Icon.astro";
import type { Project, SiteContent } from "../data/types";

interface Props {
  p: Project;
  t: SiteContent;
  index: number;
}

const { p, t, index } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const num = String(index + 1).padStart(2, "0");
const linkAttrs = (href: string) => (isExternal(href) ? { target: "_blank", rel: "noopener noreferrer" } : {});
---

<article class="project card" data-tags={p.tags.join("|")} id={`p-${p.id}`}>
  <div class:list={["media", p.fit === "contain" ? "contain" : "cover"]}>
    <img
      src={p.image}
      alt={p.imageAlt}
      loading={index < 4 ? "eager" : "lazy"}
      decoding="async"
      style={p.position ? `object-position:${p.position}` : undefined}
    />
  </div>

  <div class="body">
    <p class="kicker mono m-0">
      <span>{num}</span><span class="hidden sm:inline"> · {p.kicker}</span>
    </p>
    <h3 class="title m-0">{p.title}</h3>
    <p class="mono value m-0 sm:hidden">{p.result.value}</p>

    <!-- Computadora: detalle recortado -->
    <div class="desk hidden sm:flex">
      <p class="m-0 clamp-2 text-[0.9rem] text-[var(--mute)]">{p.question}</p>
      <p class="result m-0 clamp-3 text-[0.9rem] text-[var(--ink-2)]">
        <strong class="mono value-inline">{p.result.value}</strong> {p.result.text}
      </p>
      <div class="foot">
        {
          p.links.map((l, i) => (
            <a href={l.href} class:list={["btn btn-sm", { "btn-primary": i === 0 && l.kind === "demo" }]} {...linkAttrs(l.href)}>
              <Icon name={l.kind ?? "external"} size={14} />
              {l.label}
              {isExternal(l.href) && <Icon name="external" size={12} class="opacity-60" />}
            </a>
          ))
        }
        <ul class="chips-row m-0 flex list-none gap-1.5 p-0">
          {p.stack.slice(0, 4).map((s) => <li class="chip">{s}</li>)}
        </ul>
      </div>
    </div>

    <!-- Celular: detalle desplegable -->
    <details class="more sm:hidden">
      <summary class="mono">
        {t.ui.more}
        <svg class="chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6l6 -6" /></svg>
      </summary>
      <div class="more-body">
        <p class="m-0 text-[0.85rem] text-[var(--ink-2)]">
          <span class="label">{t.ui.question}</span>
          {p.question}
        </p>
        <p class="m-0 text-[0.85rem] text-[var(--ink-2)]">
          <span class="label">{t.ui.result}</span>
          {p.result.text}
        </p>
        <ul class="m-0 flex list-none flex-wrap gap-1 p-0">
          {p.stack.map((s) => <li class="chip !text-[0.68rem]">{s}</li>)}
        </ul>
        {p.links.map((l, i) => (
          <a href={l.href} class:list={["btn btn-sm w-full justify-center", { "btn-primary": i === 0 && l.kind === "demo" }]} {...linkAttrs(l.href)}>
            <Icon name={l.kind ?? "external"} size={14} />
            {l.label}
          </a>
        ))}
      </div>
    </details>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 14px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .project:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent) 45%, var(--rule)); }
  .media {
    aspect-ratio: 16 / 9;
    flex-shrink: 0;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }
  .media img { width: 100%; height: 100%; transition: transform 0.4s ease; }
  .project:hover .media img { transform: scale(1.025); }
  .media.cover img { object-fit: cover; }
  .media.contain { background: #fff; }
  .media.contain:has(img[src$=".svg"]) { background: #faf8f5; }
  .media.contain img { object-fit: contain; padding: 0.5rem; }
  .media.contain img[src$=".svg"] { padding: 0; }
  .media:has(img[src$=".svg"]) { background: #faf8f5; }
  .media img[src$=".svg"] { object-fit: contain; }

  .body { padding: 0.75rem 0.8rem 0.85rem; display: flex; flex-direction: column; gap: 0.3rem; flex: 1; }
  .kicker {
    font-size: 0.68rem;
    color: var(--accent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .title { font-size: 0.92rem; line-height: 1.25; font-weight: 600; letter-spacing: -0.01em; }
  .value { color: var(--accent); font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; margin-top: auto; padding-top: 0.2rem; }

  .desk { flex-direction: column; gap: 0.75rem; margin-top: 0.4rem; }
  .label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
    margin-bottom: 0.1rem;
  }
  .clamp-2, .clamp-3 { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }
  .clamp-2, .clamp-3 { -webkit-line-clamp: 2; }
  .result { padding-left: 0.7rem; border-left: 3px solid var(--accent); }
  .value-inline { color: var(--accent); font-size: 1.05rem; letter-spacing: -0.01em; }
  .chips-row { overflow: hidden; flex-wrap: nowrap; mask-image: linear-gradient(90deg, #000 85%, transparent); -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); }
  :global(.btn-sm) { padding: 0.4rem 0.7rem !important; font-size: 0.78rem !important; border-radius: 8px !important; gap: 0.35rem !important; }

  .more summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.35rem;
    font-size: 0.72rem;
    color: var(--ink-2);
    cursor: pointer;
  }
  .more summary::-webkit-details-marker { display: none; }
  .chev { transition: transform 0.2s ease; }
  .more[open] .chev { transform: rotate(180deg); }
  .more-body { display: flex; flex-direction: column; gap: 0.55rem; margin-top: 0.55rem; }
  /* En celular, la tarjeta abierta ocupa las dos columnas para no estirar a su vecina. */
  .project:has(details[open]) { grid-column: 1 / -1; }
  .project:has(details[open]) .media { aspect-ratio: 2 / 1; }
  .project:has(details[open]) .more-body .btn { width: auto; }
  .project:has(details[open]) .more-body { display: grid; grid-template-columns: 1fr; }

  @media (min-width: 640px) {
    .media { aspect-ratio: 2 / 1; }
    .body { padding: 1rem 1.2rem 1.15rem; gap: 0.3rem; }
    .kicker { font-size: 0.72rem; }
    .title { font-size: 1.12rem; }
    .value { font-size: 1.25rem; margin-top: 0.15rem; padding-top: 0; }
    .desk { flex: 1; gap: 0.6rem; margin-top: 0.25rem; }
    .foot { display: flex; align-items: center; gap: 0.5rem; margin-top: auto; min-width: 0; }
    .foot .btn { flex-shrink: 0; }
    .foot .chips-row { flex: 1; min-width: 0; }
  }
  @media (min-width: 1024px) {
    .media { aspect-ratio: 12 / 5; }
    .title { font-size: 1.2rem; }
  }
</style>
