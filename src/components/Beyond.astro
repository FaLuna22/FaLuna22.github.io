---
import Icon from "./Icon.astro";
import type { SiteContent } from "../data/types";

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
const b = t.beyond;
---

{
  b.items.length > 0 && (
    <section id="beyond" class="section">
      <div class="container-x">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-5">
            <p class="eyebrow">05</p>
            <h2 class="section-title">{b.title}</h2>
          </div>
          <p class="lead m-0 lg:col-span-7">{b.intro}</p>
        </div>
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
          {b.items.map((h) => (
            <div class="card hobby p-6">
              <span class="ico">
                <Icon name={h.icon} size={22} />
              </span>
              <h3 class="m-0 mt-4 text-lg font-semibold">{h.title}</h3>
              <p class="m-0 mt-2 text-[0.97rem] text-[var(--ink-2)]">{h.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .ico {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .hobby { transition: transform 0.2s ease; }
  .hobby:hover { transform: translateY(-3px); }
</style>
