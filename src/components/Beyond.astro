---
import Icon from "./Icon.astro";
import type { SiteContent } from "../data/types";

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
const b = t.beyond;
---

{
  b.items.length > 0 && (
    <section id="beyond" class="section">
      <div class="container-x">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-5">
            <p class="eyebrow">05</p>
            <h2 class="section-title">{b.title}</h2>
          </div>
          <p class="lead m-0 lg:col-span-7">{b.intro}</p>
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {b.items.map((h, i) => (
            <div class:list={["card hobby flex flex-col overflow-hidden", { "sm:col-span-2 featured": i === 0 && b.items.length % 2 === 1 }]}>
              {h.image && (
                <img src={h.image} alt={h.imageAlt ?? ""} loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
              )}
              <div class="p-6">
                <div class="flex items-start justify-between gap-3">
                  <span class="ico">
                    <Icon name={h.icon} size={22} />
                  </span>
                </div>
                <h3 class="m-0 mt-4 text-lg font-semibold">{h.title}</h3>
                {h.detail && <p class="mono m-0 mt-1 text-[0.8rem] font-medium text-[var(--accent)]">{h.detail}</p>}
                <p class="m-0 mt-2 text-[0.97rem] text-[var(--ink-2)]">{h.text}</p>
              </div>
            </div>
          ))}
        </div>

        {
          b.gallery.length > 0 && (
            <div class="mt-16">
              <h3 class="m-0 text-sm font-semibold uppercase tracking-[0.14em] text-[var(--mute)]">{b.galleryTitle}</h3>
              <div class="gallery mt-5 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
                {b.gallery.map((g) => (
                  <figure class="m-0">
                    <div class="frame">
                      <img src={g.src} alt={g.alt} loading="lazy" decoding="async" style={g.position ? `object-position:${g.position}` : undefined} />
                    </div>
                    <figcaption class="mt-2 text-[0.82rem] leading-snug text-[var(--mute)]">{g.caption}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </section>
  )
}

<style>
  .ico {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .hobby { transition: transform 0.2s ease; }
  .hobby:hover { transform: translateY(-3px); }
  .featured {
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 55%),
      var(--surface);
  }
  .featured h3 { font-size: 1.35rem; }
  .frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--rule);
    background: var(--bg-alt);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  figure:hover .frame img { transform: scale(1.04); }
</style>
