---
import type { SiteContent } from "../data/types";

interface Props {
  t: SiteContent;
}

const { t } = Astro.props;
---

<section id="about" class="section">
  <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="eyebrow">01</p>
      <h2 class="section-title">{t.about.title}</h2>
    </div>
    <div class="lg:col-span-8">
      <div class="flex flex-col gap-5 text-[1.075rem] leading-relaxed text-[var(--ink-2)] sm:text-lg">
        {t.about.paragraphs.map((p) => <p class="m-0">{p}</p>)}
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {t.about.skillGroups.map((g) => (
          <div class="card p-5">
            <h3 class="m-0 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--accent)]">{g.name}</h3>
            <ul class="m-0 mt-3 flex list-none flex-wrap gap-2 p-0">
              {g.items.map((s) => <li class="chip">{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
